# Example /init for the kvm-guest initramfs (BusyBox): mount the kernel
# file systems, print the ready line kvm-guest.sh waits for, then run a
# shell on the console, which the test sends commands to and powers off.
/bin/busybox mount -t proc proc /proc
/bin/busybox --install -s /bin
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
echo "kvm-guest: ready vcpus=$(nproc) online=$(cat /sys/devices/system/cpu/online)" \
    "kernel=$(uname -r) uptime=$(cut -d ' ' -f 1 /proc/uptime)"
exec sh
